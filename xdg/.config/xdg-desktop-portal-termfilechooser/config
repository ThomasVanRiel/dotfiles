# yazi as the XDG file picker.
# man 5 xdg-desktop-portal-termfilechooser
#
# cmd is resolved against the wrapper dirs shipped by the package
# (/usr/share/xdg-desktop-portal-termfilechooser/) and ~/.config/...
# Modes: suggested (start where the app asks) | default (default_dir) | last.

[filechooser]
cmd=yazi-wrapper.sh
default_dir=$HOME/Downloads
env=TERMCMD='kitty --class=termfilechooser --title=termfilechooser'
# keep in sync with ~/.zshrc: no shell runs here, so exports never reach yazi.
# Lets yazi's `z` fzf into subdirectories, not just files.
env=FZF_DEFAULT_COMMAND='fd --type f --type d --hidden --exclude .git --strip-cwd-prefix'
open_mode=suggested
save_mode=suggested
create_help_file=1
