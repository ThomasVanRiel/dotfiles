[Desktop Entry]
# yazi as the graphical file manager: the shipped yazi.desktop is Terminal=true,
# which hands the choice of terminal to the DE. This pins it to kitty, matching
# the termfilechooser setup in ~/.config/xdg-desktop-portal-termfilechooser.
Type=Application
Name=Yazi
Comment=Terminal file manager in kitty
Icon=yazi
TryExec=yazi
Exec=kitty --class=yazi --title=yazi yazi %f
Terminal=false
NoDisplay=true
# Archives too: nothing on this system opens them (no ark/file-roller), so
# Nautilus was the only claimant and bounced to the containing folder.
# yazi given a file path opens its parent with the entry selected.
MimeType=inode/directory;application/zip;application/gzip;application/bzip2;application/zstd;application/vnd.rar;application/x-7z-compressed;application/x-7z-compressed-tar;application/x-bzip;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-compress;application/x-compressed-tar;application/x-cpio;application/x-gzip;application/x-lha;application/x-lzip;application/x-lzip-compressed-tar;application/x-lzma;application/x-lzma-compressed-tar;application/x-tar;application/x-tarz;application/x-xar;application/x-xz;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;
Categories=System;FileManager;FileTools;
