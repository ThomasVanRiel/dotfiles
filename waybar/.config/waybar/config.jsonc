{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces",
        "custom/sep",
        "custom/activeapp",
        "custom/sep2",
        "hyprland/window"
    ],
    "modules-center": [
        "tray"
    ],
    "modules-right": [
        "clock",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "active-only": true,
        "format": "󰏘 {name}",
        "on-scroll-up": "",
        "on-scroll-down": "",
        "tooltip": false
    },

    "custom/sep": {
        "format": "│",
        "interval": "once",
        "tooltip": false
    },

    "custom/sep2": {
        "format": "│",
        "interval": "once",
        "tooltip": false
    },

    "custom/activeapp": {
        "exec": "~/.config/waybar/scripts/active-app.sh",
        "interval": 1,
        "tooltip": false
    },

    "hyprland/window": {
        "format": "󰖯 {}",
        "max-length": 80,
        "tooltip": false,
        "separate-outputs": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "clock": {
        "format": "󰭦 {:%A %d %B 󰅐 %H:%M}",
        "interval": 60,
        "tooltip": false
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "~/.config/scripts/lock.sh",
            "logout": "hyprctl dispatch exit",
            "reboot": "systemctl reboot",
            "poweroff": "systemctl poweroff"
        }
    }
}
