{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
	"niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
//        "custom/claude",
        "cpu",
        "memory",
        "disk",
        "temperature",
        "pulseaudio",
        "network",
        "tray",
        "custom/power"
    ],

    "niri/window": {
	"format": "{title}",
	"separate-outputs": false
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "\uf4c3",
	    "active": "\uf444"
        }
    },

    "clock": {
        "format": "{:%A, %B %d, %Y  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "format": {
                "months": "<span color='#f5e0dc'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "weeks": "<span color='#94e2d5'>W{}</span>",
                "weekdays": "<span color='#f9e2af'>{}</span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        }
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "󰘚 {used:0.1f}/{total:0.1f} GiB",
        "interval": 2,
        "on-click": "kitty -e btop"
    },

    "disk": {
        "format": "󰋊 {used}/{total}",
        "interval": 30,
        "path": "/",
        "on-click": "dolphin"
    },

    "temperature": {
        "format": "󰔏 {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "󰸁 {temperatureC}°C",
        "on-click": "kitty -e btop"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/claude": {
        "exec": "~/.config/waybar/scripts/claude-usage.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty -e claude"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "~/.config/scripts/lock-niri.sh",
            "logout": "niri msg action quit",
            "reboot": "systemctl reboot",
            "poweroff": "systemctl poweroff"
        }
    }
}
